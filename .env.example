# Public site URL, used for canonical links, the sitemap and share images.
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form delivery through Resend (https://resend.com). Without all three the
# form reports that it could not send and offers the direct email address.
RESEND_API_KEY=
# Where messages arrive. Never shown on the site.
CONTACT_TO=
# Must be on a domain verified in Resend, e.g. Portfolio <hello@yourdomain.com>.
# Portfolio <onboarding@resend.dev> works without a domain, but only delivers to
# the email address on the Resend account.
CONTACT_FROM=

# Visitor analytics. A Postgres connection string (Neon: use the pooled URL). Without it
# nothing is recorded and /stats says so.
DATABASE_URL=
# Password for the private dashboard at /stats (any username). Without it /stats is a 404.
STATS_PASSWORD=
# Visitor locations off Vercel: path to a MaxMind GeoLite2-City .mmdb file on this server,
# e.g. /var/lib/GeoIP/GeoLite2-City.mmdb. Lookups run locally. Without it, locations stay blank.
GEOIP_DB=
